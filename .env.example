# Copy to .env only when needed. Never commit real values.
# EXAMPLE_API_KEY=

# Client IP trust (default on): forwarded headers are used only when the socket
# peer is loopback. Set to off to ignore X-Real-IP / X-Forwarded-For entirely.
# VIVIC_TRUST_PROXY_IP=off

# Optional ipinfo-compatible region endpoint (e.g. a self-hosted MaxMind service).
# Per-IP lookups resolve as new URL("<ip>/json", endpoint).
# VIVIC_IP_REGION_ENDPOINT=https://ipinfo.io/json
