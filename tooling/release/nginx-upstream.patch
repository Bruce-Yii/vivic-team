--- a/etc/nginx/conf.d/60-vivic-preview-20261025.conf
+++ b/etc/nginx/conf.d/60-vivic-preview-20261025.conf
@@ -1,3 +1,17 @@
+# --- Vivic API upstream (release-v2 options C + D) ---------------------------
+# Single switch point for the loopback port that serves /api, /api/ and /healthz.
+# A release script rewrites /etc/nginx/vivic-upstream-active.conf (one line,
+# `server 127.0.0.1:18890;` or `server 127.0.0.1:18891;`) and then runs
+# `nginx -t && nginx -s reload`. Reload keeps existing connections alive, so the
+# switch costs no request loss.
+#
+# max_fails=0 disables passive ejection: during a release the backend is down for
+# a moment by design and nginx must not mark it unavailable afterwards.
+upstream vivic_api {
+    include /etc/nginx/vivic-upstream-active.conf;
+    keepalive 32;
+}
+
 server {
     listen 80;
     server_name vivic.edsionc.top;
@@ -38,28 +52,50 @@
     }
     access_log off;
     location ^~ /api/ {
-        proxy_pass http://127.0.0.1:18890;
+        proxy_pass http://vivic_api;
         proxy_set_header Host $host;
         proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header Connection "";
         proxy_http_version 1.1;
         proxy_buffering off;
         proxy_read_timeout 200s;
+        proxy_next_upstream error timeout http_502 http_503;
+        proxy_next_upstream_timeout 5s;
+        proxy_intercept_errors on;
+        error_page 502 503 504 = @vivic_maintenance;
     }
     location = /api {
-        proxy_pass http://127.0.0.1:18890;
+        proxy_pass http://vivic_api;
         proxy_set_header Host $host;
         proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header Connection "";
         proxy_http_version 1.1;
         proxy_buffering off;
         proxy_read_timeout 200s;
+        proxy_next_upstream error timeout http_502 http_503;
+        proxy_next_upstream_timeout 5s;
+        proxy_intercept_errors on;
+        error_page 502 503 504 = @vivic_maintenance;
     }
     location = /healthz {
-        proxy_pass http://127.0.0.1:18890;
+        proxy_pass http://vivic_api;
         proxy_set_header Host $host;
         proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header Connection "";
         proxy_http_version 1.1;
         proxy_buffering off;
         proxy_read_timeout 200s;
+        proxy_next_upstream error timeout http_502 http_503;
+        proxy_next_upstream_tries 2;
+    }
+    # Option D: during the release window the caller gets a machine-readable,
+    # explicitly retryable answer instead of a bare 502 HTML page.
+    location @vivic_maintenance {
